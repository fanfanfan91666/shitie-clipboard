<Window x:Class="Shitie.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="拾贴 · 剪切板" Width="1120" Height="770" MinWidth="980" MinHeight="630" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#F5F7FA" FontFamily="Microsoft YaHei UI" FontSize="13" Closing="OnClosing" PreviewKeyDown="OnWindowKeyDown" Icon="Assets/shitie.ico">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#DCE3E8" BorderThickness="1" CornerRadius="11">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#132B38" CornerRadius="10,0,0,10">
        <Grid Margin="20,30,20,20">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <Border Width="44" Height="44" CornerRadius="13" Background="#57C4B6" HorizontalAlignment="Left"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#0E3C42" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="拾贴" FontSize="27" FontWeight="SemiBold" Foreground="White" Margin="0,13,0,4"/>
            <TextBlock Text="留住每一次复制" FontSize="12" Foreground="#8FA9B5"/>
            <Border Height="1" Background="#29414E" Margin="0,27,0,22"/>
            <Button x:Name="HistoryNav" Style="{StaticResource Nav}" Click="HistoryNavClick" Background="#284754" shell:WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Foreground="#CEEAE6" Margin="0,2,13,0"/><TextBlock Text="剪切板历史" Foreground="#E0EFEE"/></StackPanel></Button>
            <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Click="SettingsNavClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#A6BFCA" Margin="0,2,13,0"/><TextBlock Text="偏好设置" Foreground="#CADBE2"/></StackPanel></Button>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Ellipse x:Name="RecordingDot" Width="7" Height="7" Fill="#63CDB7" Margin="0,0,8,0"/><TextBlock x:Name="RecordingLabel" Text="正在记录" Foreground="#BAD3DA" FontSize="12"/></StackPanel>
            <Border Background="#203E4C" CornerRadius="7" Padding="9,8"><TextBlock x:Name="HotkeyLabel" Text="Ctrl + Shift + V" FontSize="12" Foreground="#D0E3E8" HorizontalAlignment="Center"/></Border>
            <TextBlock Text="随时唤起，随手找回" Foreground="#819FAA" FontSize="11" Margin="0,9,0,22"/>
            <TextBlock Text="拾贴  1.0.1" Foreground="#65838F" FontSize="11"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Grid Margin="28,0,8,0"><TextBlock Text="你的本地剪切板" Foreground="#8996A0" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource Quiet}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="39" ToolTip="最小化" Click="MinimizeClick"/><Button Style="{StaticResource Quiet}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="39" ToolTip="最大化 / 还原" Click="MaximizeClick"/><Button Style="{StaticResource Quiet}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="39" ToolTip="收起到托盘" Click="HideClick"/></StackPanel></Grid>
        <Grid x:Name="HistoryView" Grid.Row="1" Margin="28,14,28,8">
          <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="56"/><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
          <Grid><StackPanel><TextBlock Text="剪切板历史" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="复制过的内容，都在这里。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="StatsLabel" Text="0 条记录" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/><Button x:Name="PauseButton" Style="{StaticResource Quiet}" Content="暂停记录" Click="PauseClick" Margin="0,3,-8,0"/></StackPanel></Grid>
          <Grid Grid.Row="1" Height="42" VerticalAlignment="Top"><TextBox x:Name="SearchBox" Padding="37,10,30,9" TextChanged="SearchChanged" AutomationProperties.Name="搜索剪切板历史"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#93A0AA" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock x:Name="SearchPlaceholder" Text="搜索文字、文件名或来源…" Foreground="#99A5AD" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><Button Style="{StaticResource Quiet}" Content="×" HorizontalAlignment="Right" Click="ClearSearchClick" ToolTip="清空搜索"/></Grid>
          <Grid Grid.Row="2"><StackPanel Orientation="Horizontal" VerticalAlignment="Top"><RadioButton Content="全部" GroupName="Filters" IsChecked="True" Style="{StaticResource Filter}" Tag="All" Checked="FilterChanged"/><RadioButton Content="文字" GroupName="Filters" Style="{StaticResource Filter}" Tag="Text" Checked="FilterChanged"/><RadioButton Content="图片" GroupName="Filters" Style="{StaticResource Filter}" Tag="Image" Checked="FilterChanged"/><RadioButton Content="文件" GroupName="Filters" Style="{StaticResource Filter}" Tag="Files" Checked="FilterChanged"/></StackPanel><Button Content="清空历史" Style="{StaticResource Quiet}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ClearHistoryClick"/></Grid>
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="286"/></Grid.ColumnDefinitions>
            <Grid>
              <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="SelectionChanged" MouseDoubleClick="HistoryDoubleClick" AutomationProperties.Name="历史记录列表">
                <ListBox.ItemTemplate><DataTemplate><Grid Margin="16,14,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource Accent}" FontSize="11"/></StackPanel><TextBlock Grid.Row="1" Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="63" LineHeight="21" Margin="0,10,0,12"/><TextBlock Grid.Row="2" Text="{Binding Meta}" FontSize="10.5" Foreground="#8B98A2" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="270"><Border Width="62" Height="62" Background="#E6EEEF" CornerRadius="20" Margin="0,0,0,18"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#8BA5AB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmptyTitle" Text="从下一次复制开始" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyHint" Text="复制一段文字、一张图片或一个文件，&#x0a;拾贴会替你保存在这里。" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,9,0,0"/></StackPanel>
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="19">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="内容预览" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="PreviewMeta" Grid.Row="1" Text="选择一条记录，查看完整内容" Style="{StaticResource Hint}" Margin="0,8,0,15"/>
                <Grid Grid.Row="2"><TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Top" FontSize="12.5" AcceptsReturn="True" AutomationProperties.Name="完整内容预览"/><ScrollViewer x:Name="PreviewImageScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Image x:Name="PreviewImage" Stretch="Uniform" VerticalAlignment="Top"/></ScrollViewer></Grid>
                <StackPanel Grid.Row="3" Margin="0,18,0,0"><Button x:Name="CopyButton" Style="{StaticResource Primary}" Content="复制到剪切板" Click="CopyClick" IsEnabled="False"/><Button x:Name="DeleteButton" Style="{StaticResource Quiet}" Content="删除这条记录" Click="DeleteClick" IsEnabled="False" Margin="0,7,0,0"/><TextBlock Text="复制后排到最前 · Enter 复制" Style="{StaticResource Hint}" FontSize="10.5" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel>
              </Grid>
            </Border>
          </Grid>
          <Grid Grid.Row="4"><TextBlock x:Name="ResultLabel" Text="" Foreground="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Bottom"/><Button x:Name="LoadMoreButton" Content="加载更多" Style="{StaticResource Quiet}" FontSize="11" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="LoadMoreClick" Visibility="Collapsed"/></Grid>
        </Grid>
        <Grid x:Name="SettingsView" Grid.Row="1" Margin="28,14,28,8" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="61"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="偏好设置" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="让每一次复制，都有恰到好处的回应。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="日常使用" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="HistoryEnabledCheck" Content="记录剪切板历史"/><TextBlock Text="关闭记录后仍可使用提示音和查看已有历史；托盘中的“暂停记录”可快速切换。" Style="{StaticResource Hint}" Margin="20,0,0,12"/><CheckBox x:Name="StartupCheck" Content="开机自动启动，安静留在系统托盘"/><TextBlock Text="关闭窗口会收起到右下角托盘；完全退出请使用托盘右键菜单。" Style="{StaticResource Hint}" Margin="20,0,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="复制与剪切音效" Style="{StaticResource SectionTitle}"/><TextBlock Text="系统剪切板确实更新后才响，帮助确认已经复制成功。" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><CheckBox x:Name="CopySoundCheck" Content="复制成功提示音"/><ComboBox x:Name="CopyToneBox" Grid.Column="1" Margin="8,0,10,0" AutomationProperties.Name="复制提示音"/><Button Grid.Column="2" Content="试听" Click="PreviewCopySoundClick"/></Grid>
                <Grid Margin="0,9,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBox x:Name="CopyPathBox" IsReadOnly="True" ToolTip="自定义 WAV 音效路径" FontSize="11"/><Button Grid.Column="1" Content="选择文件" Margin="8,0,0,0" Padding="6" Click="BrowseCopySoundClick"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/></Grid.ColumnDefinitions><CheckBox x:Name="CutSoundCheck" Content="剪切成功提示音"/><ComboBox x:Name="CutToneBox" Grid.Column="1" Margin="8,0,10,0" AutomationProperties.Name="剪切提示音"/><Button Grid.Column="2" Content="试听" Click="PreviewCutSoundClick"/></Grid>
                <Grid Margin="0,9,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><TextBox x:Name="CutPathBox" IsReadOnly="True" ToolTip="自定义 WAV 音效路径" FontSize="11"/><Button Grid.Column="1" Content="选择文件" Margin="8,0,0,0" Padding="6" Click="BrowseCutSoundClick"/></Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><TextBlock Text="音效音量" VerticalAlignment="Center"/><Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="15,0"/><TextBlock Grid.Column="2" Text="{Binding ElementName=VolumeSlider,Path=Value,StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></Grid>
                <CheckBox x:Name="MuteScreenshotsCheck" Content="系统截图自动复制时，拾贴不重复播放音效" Margin="0,17,0,5"/>
                <TextBlock Text="截图照常进入历史，保留 Windows 自带的截图提示音。其他软件复制图片、在截图工具中按 Ctrl+C、从拾贴历史重新复制图片仍有提示音。" Style="{StaticResource Hint}" Margin="20,0,0,0"/>
                <TextBlock Text="仅识别 Windows 截图工具的图片来源。截图工具内用鼠标点击复制图片也可能保持静音；可使用 Ctrl+C 或关闭上方选项。" Style="{StaticResource Hint}" Margin="20,5,0,0"/>
                <TextBlock Text="Ctrl+X、Shift+Delete 和文件剪切可使用独立音效。部分软件右键剪切文字无法区分，会使用复制音效。" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="快捷唤起" Style="{StaticResource SectionTitle}"/><TextBlock Text="点击下方输入框，然后按下你想使用的组合键。若已被占用，保存时会提示。" Style="{StaticResource Hint}" Margin="0,0,0,12"/><TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="HotkeyBoxKeyDown" ToolTip="点击后按组合键，例如 Ctrl + Shift + V" AutomationProperties.Name="唤起快捷键"/><TextBlock Text="建议使用 Ctrl / Alt 搭配字母、数字或 F1–F11；避免覆盖日常复制粘贴操作。" Style="{StaticResource Hint}" Margin="0,8,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="历史保留" Style="{StaticResource SectionTitle}"/><Grid Margin="0,8,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="自动删除时间" VerticalAlignment="Center"/><ComboBox x:Name="RetentionBox" Grid.Column="1" SelectedValuePath="Tag"><ComboBoxItem Content="7 天" Tag="7"/><ComboBoxItem Content="30 天" Tag="30"/><ComboBoxItem Content="90 天" Tag="90"/><ComboBoxItem Content="180 天" Tag="180"/><ComboBoxItem Content="1 年（365 天）" Tag="365"/><ComboBoxItem Content="2 年（730 天）" Tag="730"/><ComboBoxItem Content="永久保留" Tag="0"/></ComboBox></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="历史空间上限" VerticalAlignment="Center"/><ComboBox x:Name="StorageBox" Grid.Column="1" SelectedValuePath="Tag"><ComboBoxItem Content="128 MB" Tag="128"/><ComboBoxItem Content="512 MB" Tag="512"/><ComboBoxItem Content="1 GB" Tag="1024"/><ComboBoxItem Content="2 GB" Tag="2048"/></ComboBox></Grid><TextBlock Text="按最后一次复制计算保留时间，启动时和运行中自动清理。达到空间上限时，先删除最早的记录。" Style="{StaticResource Hint}" Margin="0,12,0,0"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="只留在这台电脑" Style="{StaticResource SectionTitle}"/><TextBlock Text="内容使用当前 Windows 账户加密保存。应用不联网、不上传；尊重软件主动标记为“不要记录”的剪切板内容。" Style="{StaticResource Hint}"/><TextBlock Text="文字、图片和文件路径可记录；文件本身不会备份。单条文字最多 200 万字，图片最多 16 MB / 2500 万像素。" Style="{StaticResource Hint}" Margin="0,7,0,0"/><Button Content="打开本地数据文件夹" HorizontalAlignment="Left" Click="OpenDataFolderClick" Margin="0,14,0,0"/><TextBlock x:Name="DataPathLabel" Style="{StaticResource Hint}" FontSize="10.5" Margin="0,10,0,0"/></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="2"><TextBlock x:Name="SettingsFeedback" Text="修改后点击保存生效" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,150,0"/><Button x:Name="SaveSettingsButton" Content="保存设置" Style="{StaticResource Primary}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="25,11" Click="SaveSettingsClick"/></Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#E8ECF0" BorderThickness="0,1,0,0" Padding="28,0"><Grid><TextBlock x:Name="StatusLabel" Text="已就绪 · 内容仅保存在本机" Foreground="#82919B" FontSize="10.5" VerticalAlignment="Center"/><TextBlock Text="Esc 收起" Foreground="#A2ADB5" FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
      </Grid>
    </Grid>
  </Border>
</Window>
